rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // El doc id de un store es el uid de su dueño.
    function isOwner(storeId) {
      return signedIn() && uid() == storeId;
    }

    function memberDoc(storeId) {
      return /databases/$(database)/documents/store_members/$(storeId + '_' + uid());
    }

    function isMember(storeId) {
      return signedIn() && exists(memberDoc(storeId));
    }

    function memberRole(storeId) {
      return get(memberDoc(storeId)).data.role;
    }

    // Dueño o miembro activo: puede leer/escribir los datos de la tienda.
    function canAccess(storeId) {
      return isOwner(storeId) || isMember(storeId);
    }

    // Gerente o dueña: además pueden editar precios y ver reportes.
    function isManagerUp(storeId) {
      return isOwner(storeId) || (isMember(storeId) && memberRole(storeId) in ['owner', 'manager']);
    }

    function accessExisting() {
      return signedIn() && canAccess(resource.data.store_id);
    }

    function accessIncoming() {
      return signedIn() && canAccess(request.resource.data.store_id);
    }

    // --- Tienda: la lee cualquier miembro; solo la dueña la edita (datos/preferencias). ---
    match /stores/{storeId} {
      allow read: if isOwner(storeId) || isMember(storeId);
      allow write: if isOwner(storeId);
    }

    function invitePath(token) {
      return /databases/$(database)/documents/store_invites/$(token);
    }

    // --- Miembros activos. Doc id = `${storeId}_${uid}`. ---
    match /store_members/{id} {
      // El propio usuario (para resolver su acceso) o cualquier miembro de la tienda.
      allow read: if signedIn() &&
        (resource.data.user_id == uid() || canAccess(resource.data.store_id));

      // La dueña agrega su propia membresía, o el invitado acepta vía token: la
      // membresía referencia el invite_token y debe coincidir tienda + rol.
      allow create: if isOwner(request.resource.data.store_id)
        || (signedIn()
            && id == request.resource.data.store_id + '_' + uid()
            && request.resource.data.user_id == uid()
            && exists(invitePath(request.resource.data.invite_token))
            && get(invitePath(request.resource.data.invite_token)).data.store_id == request.resource.data.store_id
            && get(invitePath(request.resource.data.invite_token)).data.role == request.resource.data.role);

      // La dueña cambia roles; el propio usuario solo actualiza su last_active.
      allow update: if isOwner(resource.data.store_id)
        || (resource.data.user_id == uid()
            && request.resource.data.role == resource.data.role);

      allow delete: if isOwner(resource.data.store_id);
    }

    // --- Invitaciones. Doc id = token aleatorio (secreto del link). ---
    match /store_invites/{token} {
      // get por token (aceptar): cualquier sesión con el link. list: solo la dueña.
      allow get: if signedIn();
      allow list: if isOwner(resource.data.store_id);
      allow create, update: if isOwner(request.resource.data.store_id);
      // La dueña cancela; el invitado la consume al aceptar (ya es miembro).
      allow delete: if isOwner(resource.data.store_id) || isMember(resource.data.store_id);
    }

    // --- Colecciones scopeadas por store_id (acceso por membresía). ---
    match /products/{id} {
      allow read, delete: if accessExisting();
      allow create: if accessIncoming();
      allow update: if accessExisting() && accessIncoming();
    }

    match /categories/{id} {
      allow read, delete: if accessExisting();
      allow create: if accessIncoming();
      allow update: if accessExisting() && accessIncoming();
    }

    match /sales/{id} {
      allow read, delete: if accessExisting();
      allow create: if accessIncoming();
      allow update: if accessExisting() && accessIncoming();
    }

    match /price_history/{id} {
      allow read, delete: if accessExisting();
      allow create: if accessIncoming();
      allow update: if accessExisting() && accessIncoming();
    }

    match /cash_registers/{id} {
      // La caja del día se consulta antes de existir (primera venta).
      allow read: if signedIn() && (resource == null || canAccess(resource.data.store_id));
      allow delete: if accessExisting();
      allow create: if accessIncoming();
      allow update: if accessExisting() && accessIncoming();
    }

    match /clients/{id} {
      allow read, delete: if accessExisting();
      allow create: if accessIncoming();
      allow update: if accessExisting() && accessIncoming();
    }

    // Ledger de movimientos de stock: append-only (no update/delete).
    match /stock_movements/{id} {
      allow read: if accessExisting();
      allow create: if accessIncoming();
    }

    // Abonos de fiados: append-only (delete permitido a miembros).
    match /payments/{id} {
      allow read, delete: if accessExisting();
      allow create: if accessIncoming();
    }

    // Todo lo demás queda denegado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
